# Coder CDE — runtime environment variables
# Copy to .env and fill in the values before starting the service.
# Do NOT commit .env to version control.

# ── Coder core ────────────────────────────────────────────────────────────────
CODER_HTTP_ADDRESS=0.0.0.0:7080

# ── Database (existing PostgreSQL cluster) ────────────────────────────────
# DB_HOST=myserver.postgres.database.azure.com
# DB_PASS=mypassword
# DB_USER=coder          # optional, defaults to 'coder'
# Pulumi creates the 'coder' database and injects CODER_PG_CONNECTION_URL.
# For local dev, CODER_PG_CONNECTION_URL is set by docker-compose.override.yml

# Public URL that users and agents connect to (must be reachable from browsers)
CODER_ACCESS_URL=https://coder.myorg.com

# Wildcard domain for workspace port-forwarding (e.g. *.coder.myorg.com)
CODER_WILDCARD_ACCESS_URL=*.coder.myorg.com

# ── Optional ──────────────────────────────────────────────────────────────────
# Pin a specific Coder image version (defaults to v2.34.3)
# CODER_VERSION=v2.34.3
